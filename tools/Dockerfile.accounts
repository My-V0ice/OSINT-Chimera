FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN --mount=type=cache,target=/root/.cache/pip pip install fastapi==0.128.0 uvicorn==0.40.0 httpx==0.28.1
RUN --mount=type=cache,target=/root/.cache/pip python -m venv /opt/socialscan && /opt/socialscan/bin/pip install socialscan==2.0.1
RUN --mount=type=cache,target=/root/.cache/pip python -m venv /opt/pywhat && /opt/pywhat/bin/pip install pywhat==5.1.0
RUN --mount=type=cache,target=/root/.cache/pip python -m venv /opt/ignorant && /opt/ignorant/bin/pip install ignorant==1.2 phonenumbers==9.0.21 httpx==0.28.1
ARG WMN_REVISION=35576e909ce4846c769d353f7979d11ac25516b6
RUN mkdir /opt/wmn && python -c "import urllib.request; urllib.request.urlretrieve('https://raw.githubusercontent.com/WebBreacher/WhatsMyName/${WMN_REVISION}/wmn-data.json', '/opt/wmn/wmn-data.json')"
RUN useradd -m -u 10001 chimera
COPY tools/runner.py tools/accounts_json.py tools/account_results.py tools/pywhat_json.py /opt/runner/
COPY app/result_rules.py /opt/runner/result_rules.py
USER chimera
WORKDIR /opt/runner
CMD ["python", "-m", "uvicorn", "runner:app", "--host", "0.0.0.0", "--port", "8010", "--no-access-log"]
