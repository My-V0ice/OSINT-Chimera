FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev libffi-dev libxml2-dev libxslt1-dev && rm -rf /var/lib/apt/lists/*
RUN --mount=type=cache,target=/root/.cache/pip pip install fastapi==0.128.0 uvicorn==0.40.0
RUN --mount=type=cache,target=/root/.cache/pip python -m venv /opt/maigret && /opt/maigret/bin/pip install maigret==0.6.0
RUN --mount=type=cache,target=/root/.cache/pip python -m venv /opt/sherlock && /opt/sherlock/bin/pip install sherlock-project==0.15.0
RUN --mount=type=cache,target=/root/.cache/pip python -m venv /opt/holehe && /opt/holehe/bin/pip install holehe==1.61
RUN useradd -m -u 10001 chimera
COPY tools/runner.py tools/holehe_json.py /opt/runner/
COPY app/result_rules.py /opt/runner/result_rules.py
USER chimera
WORKDIR /opt/runner
CMD ["python", "-m", "uvicorn", "runner:app", "--host", "0.0.0.0", "--port", "8010", "--no-access-log"]
